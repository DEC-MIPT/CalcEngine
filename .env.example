# Backend database connection strings, per backend-layered-architecture design.md
# decision 4 (two PostgreSQL databases: dec_app, dec_normatives).
# Variable names are read by backend/app/core/config.py, confirmed by
# backend-layered-architecture task 2.1 (first chosen in bootstrap-dev-environment
# task 4.3).
# pragma: allowlist nextline secret
DEC_APP_DATABASE_URL=postgresql://dec_app_user:changeme@localhost:5433/dec_app
# The normative catalog, read through the role dec_normatives_reader
# (normative-catalog-backend design.md decision 1). Until Egor's infrastructure change
# splits the databases, the catalog lives in his database dec on dec-postgres. The
# password is the one his ingestion sets from DEC_NORMATIVES_READER_PASSWORD.
# pragma: allowlist nextline secret
DEC_NORMATIVES_DATABASE_URL=postgresql://dec_normatives_reader:changeme@localhost:5433/dec
# Optional, read by ApiSettings (calculation-api design.md decision 7); uncomment to set.
# DEC_CORS_ORIGINS: comma-separated origins allowed to call the API (none by default).
# DEC_CORS_ORIGINS=http://localhost:5173
# DEC_PARAMS_ROOT: folder of the engineer-set parameter files (backend/params by default).
# DEC_PARAMS_ROOT=/path/to/params
# Optional, read by ParameterSourceSettings (interim-normatives-source design.md decision 7).
# DEC_PARAMETER_SOURCE: catalog (default) or interim, for every calculation type at once.
# DEC_PARAMETER_SOURCE=catalog
# DEC_INTERIM_PROFILE: strict (default, only verifier-checked records) or draft.
# DEC_INTERIM_PROFILE=strict
# DEC_INTERIM_ROOT: folder of the interim data (backend/interim_normatives by default).
# DEC_INTERIM_ROOT=/path/to/interim_normatives
