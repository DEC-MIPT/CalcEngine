prefix_rule(pattern = ["git", "add"], decision = "prompt")
prefix_rule(pattern = ["git", "commit"], decision = "prompt")
prefix_rule(pattern = ["git", "merge"], decision = "prompt")
prefix_rule(pattern = ["git", "push"], decision = "prompt")
prefix_rule(pattern = ["docker"], decision = "prompt")
prefix_rule(pattern = ["npm", "install"], decision = "prompt")
prefix_rule(pattern = ["npm", "i"], decision = "prompt")
prefix_rule(pattern = ["pip", "install"], decision = "prompt")
prefix_rule(pattern = ["pip3", "install"], decision = "prompt")
prefix_rule(pattern = ["sudo"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["rm", "-rf"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["rm", "-fr"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["rm", "-r", "-f"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["rm", "-f", "-r"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["git", "clean", "-f"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["git", "branch", "-D"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
prefix_rule(pattern = ["chmod", "-R", "777"], decision = "forbidden", justification = "Mirrored Claude deny intent; use a non-destructive operation.")
